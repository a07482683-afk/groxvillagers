package com.example.realvillagers;

import net.minecraft.server.level.ServerPlayer;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Locale;

public class ChatHandler {
    public static void onChat(ServerPlayer p, String raw) {
        p.server.execute(() -> {
            List<RealVillager> list = p.level().getEntitiesOfClass(RealVillager.class, p.getBoundingBox().inflate(12), RealVillager::isAlive);
            if (list.isEmpty()) return;
            String low = raw.toLowerCase(Locale.ROOT);
            List<RealVillager> targets = new ArrayList<>();

            if (low.startsWith("все ") || low.startsWith("все,") || low.startsWith("всем")) targets.addAll(list);
            else {
                // кому обращаются: житель, чьё имя стоит в сообщении раньше всех
                RealVillager chosen = null; int best = Integer.MAX_VALUE;
                for (RealVillager v : list) {
                    int i = low.indexOf(v.getBaseName().toLowerCase(Locale.ROOT));
                    if (i >= 0 && i < best) { best = i; chosen = v; }
                }
                if (chosen == null) chosen = list.stream().min(Comparator.comparingDouble(v -> v.distanceToSqr(p))).get();
                targets.add(chosen);
            }

            for (RealVillager v : targets) {
                v.remember(p.getName().getString() + " сказал: \"" + RealVillager.cut(raw) + "\"");
                if (AiBrain.enabled) AiBrain.ask(v, p, raw);
                else v.handleChat(p, raw);
            }
        });
    }
}
